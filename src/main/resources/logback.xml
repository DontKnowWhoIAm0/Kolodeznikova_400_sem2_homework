<configuration>

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%date][%level][%thread][%logger{15}] %message%n%xException{5}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="console"/>
    </root>

<!--    <ru.kpfu.itis.Kolodeznikova level="DEBUG">-->

<!--    </ru.kpfu.itis.Kolodeznikova>-->
</configuration>
